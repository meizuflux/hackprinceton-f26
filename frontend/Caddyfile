{$MAPLETRACE_DOMAIN::80} {
	root * /srv

	handle /health {
		respond "ok" 200
	}

	handle_path /api/* {
		# Match the backend's upload limit; permit long-running analysis requests.
		request_body {
			max_size 100MiB
		}
		reverse_proxy backend:8000 {
			transport http {
				dial_timeout 10s
				response_header_timeout 600s
			}
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
