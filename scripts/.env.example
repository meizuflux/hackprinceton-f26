# Copy to scripts/.env and fill in values. This file is for local deployment only.
# The Vultr API key is used locally and is never copied to the server.
VULTR_API_KEY=

# Optional; sent to the backend to enable uncached LLM calls.
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Models per role, provider:model (backend/README.md, "Choosing models")
# MAPLETRACE_INVESTIGATOR_MODEL=anthropic:claude-sonnet-5-5
# MAPLETRACE_CHAT_MODEL=google_genai:gemini-3-pro
# MAPLETRACE_VISION_MODEL=
# MAPLETRACE_LABELS_MODEL=anthropic:claude-haiku-5-5
# MAPLETRACE_CORS=https://trusted.example
