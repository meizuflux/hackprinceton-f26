# Copy to scripts/.env and fill in values. This file is for local deployment only.
# The Vultr API key is used locally and is never copied to the server.
VULTR_API_KEY=

# Optional; sent to the backend to enable uncached LLM calls.
ANTHROPIC_API_KEY=
# MAPLETRACE_LLM_MODEL=claude-sonnet-5-5
# MAPLETRACE_CHAT_MODEL=claude-sonnet-5-5
# MAPLETRACE_CORS=https://trusted.example
