# Build context for backend/Dockerfile is the repository root (the frontend image uses
# frontend/ and frontend/.dockerignore). The backend image needs only backend/ code, demo/,
# llm_cache/, requirements.txt and the Kestrel upload ZIP; everything else stays out, including
# secrets, answer keys (.truth/), the generator, run outputs and virtual environments.
**

!backend/requirements.txt
!backend/mapletrace_api/
!backend/mapletrace_ingest/
!backend/mapletrace_reason/
!backend/demo/
!backend/llm_cache/
!cases/kestrel/kestrel_case_upload.zip

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/.env
**/.env.*
